---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  quote: string;
  name: string;
  title: string;
  imagepath: ImageMetadata;
}

const { quote, name, title, imagepath } = Astro.props;
---

<article
  class="card card-body flex min-h-[23rem] w-[84vw] max-w-[24rem] flex-none select-none justify-between rounded-3xl border-2 border-white/80 bg-slate-950 text-white shadow-2xl sm:w-[22rem] lg:w-[30rem]"
>
  <blockquote
    class="whitespace-pre-wrap text-[0.98rem] leading-relaxed sm:text-base"
  >
    {quote}
  </blockquote>
  <footer class="mt-6 flex items-center justify-between gap-4">
    <div class="flex w-44 flex-col whitespace-normal">
      <h3 class="font-bold leading-tight">{name}</h3><p
        class="mt-1 text-sm leading-snug text-white/85"
      >
        {title}
      </p>
    </div>
    <div class="avatar">
      <div class="w-20 rounded-full ring ring-white sm:w-24">
        <Image
          src={imagepath}
          alt={"Picture of " + name}
          draggable={false}
          class="select-none"
        />
      </div>
    </div>
  </footer>
</article>

<style>
  @media (hover: none) {
    article {
      scroll-snap-align: center;
    }
  }
</style>
