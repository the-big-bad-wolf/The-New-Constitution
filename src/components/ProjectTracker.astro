---
const overallTracker = {
  title: "New Constitution Project",
  status: "In active drafting",
  stage: "mid",
};

const trackerNodes = [
  { label: "Foundation", state: "done" },
  { label: "Drafting", state: "active" },
  { label: "Consultation", state: "upcoming" },
  { label: "Release", state: "upcoming" },
];

const currentMonthYear = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
}).format(new Date());

const currentIssues = [
  "Defining roles and powers of the Federal Ministers",
  "Designing the Federal Electoral Commission and the election process",
];
---

<section
  class="bg-primary bg-meander_dark [background-size:25px,25px] bg-repeat-x bg-top px-4 py-12 lg:py-16"
>
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-3">
      <div>
        <h2 class="font-[Poppins] text-3xl text-base-content lg:text-5xl">
          Project Tracker
        </h2>
        <p class="mt-2 max-w-[70ch] text-base-content/75 lg:text-lg">
          Status of The New Constitution Project as of {currentMonthYear}
        </p>
      </div>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
      <article
        class="rounded-xl border border-base-content/20 bg-white/60 p-5 shadow-sm"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="font-[Poppins] text-lg font-semibold text-base-content">
            {overallTracker.title}
          </h3>
          <span
            class="badge h-auto whitespace-normal border-base-content/20 bg-base-100/60 text-center text-base-content"
          >
            {overallTracker.status}
          </span>
        </div>
        <div
          class="mt-3 flex items-center gap-2"
          aria-label={`Current stage: ${overallTracker.stage}`}
        >
          <span
            class={`h-2.5 flex-1 rounded-full ${overallTracker.stage === "early" ? "bg-accent" : "bg-base-content/20"}`}
          ></span>
          <span
            class={`h-2.5 flex-1 rounded-full ${overallTracker.stage === "mid" ? "bg-accent" : "bg-base-content/20"}`}
          ></span>
          <span
            class={`h-2.5 flex-1 rounded-full ${overallTracker.stage === "late" ? "bg-accent" : "bg-base-content/20"}`}
          ></span>
        </div>
        <p class="mt-2 text-xs uppercase tracking-wide text-base-content/60">
          Stage marker: early / mid / late
        </p>

        <div class="mt-8 grid grid-cols-4 items-start gap-1 sm:gap-4">
          {
            trackerNodes.map((node, index) => (
              <div class="relative flex flex-col items-center text-center">
                {index > 0 && (
                  <span class="absolute left-[-50%] top-3 h-0.5 w-full bg-base-content/20" />
                )}
                <span
                  class={`relative z-10 h-6 w-6 rounded-full border-2 ${node.state === "done" ? "border-accent bg-accent" : node.state === "active" ? "border-accent bg-primary" : "border-base-content/30 bg-primary"}`}
                />
                <span
                  class={`mt-2 break-words text-[0.6rem] font-medium leading-tight sm:text-xs sm:uppercase sm:tracking-wide ${node.state === "active" ? "text-base-content" : "text-base-content/60"}`}
                >
                  {node.label}
                </span>
              </div>
            ))
          }
        </div>
      </article>

      <aside
        class="rounded-xl border border-base-content/20 bg-white/60 p-5 shadow-sm"
      >
        <h3 class="font-[Poppins] text-lg font-semibold text-base-content">
          Current Work Items
        </h3>
        <p class="mt-1 text-sm text-base-content/70">
          What is currently being worked on.
        </p>
        <ul class="mt-4 space-y-3">
          {
            currentIssues.map(issue => (
              <li class="rounded-lg border border-base-content/15 bg-primary/70 p-3 text-sm text-base-content">
                {issue}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
