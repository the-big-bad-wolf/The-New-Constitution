---
import { getEntry, render } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MobileTableOfContents from "../components/MobileTableOfContents.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { buildTocItems } from "../utils/toc";

const draftDocument = await getEntry("documents", "draft");

if (!draftDocument) {
  throw new Error("Missing draft document at src/content/documents/draft.md");
}

const { Content, headings } = await render(draftDocument);
const tocItems = buildTocItems(headings);
const lastRevisedIso = "2026-03-15";
const lastRevisedLabel = "March 15, 2026";
---

<MainLayout
  title={`${draftDocument.data.title} | New Constitution Project`}
  description={draftDocument.data.description ??
    "The full text of a new constitution for a sovereign Federation of States."}
>
  <div class="bg-meander_dark [background-size:25px,25px] bg-repeat-x">
    <div class="mx-auto max-w-5xl px-2 sm:px-8 pt-16 text-center">
      <h1 class="text-5xl font-semibold">
        {draftDocument.data.title}
      </h1>
      <div class="mt-3 flex flex-col items-center gap-1 text-sm">
        <p class="text-yellow-500">Early draft</p>
        <p class="text-base-content/70">
          Last revised <time datetime={lastRevisedIso}>{lastRevisedLabel}</time>
        </p>
      </div>
    </div>
  </div>

  <MobileTableOfContents items={tocItems} />

  <div class="flex justify-center">
    <div class="hidden xl:block xl:mr-8 mb-16">
      <TableOfContents items={tocItems} />
    </div>

    <article
      class="document-content min-w-0 flex-1 mx-1 px-2 sm:px-8 my-5 lg:my-16 max-w-5xl"
    >
      <Content />
    </article>

    <div class="hidden xl:block mb-16">
      <ReadingProgress markers={tocItems.map(item => item.href)} />
    </div>
  </div>
</MainLayout>
