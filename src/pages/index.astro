---
import { Image } from "astro:assets";
import CardGallery from "../components/CardGallery.astro";
import Morpher from "../components/Morpher";
import MainLayout from "../layouts/MainLayout.astro";
import "../misc.css";
import Benefits from "../components/Benefits.astro";
import Share from "../components/Share.astro";
import ladyJustice from "../assets/justice.svg";
---

<MainLayout
  title="New Constitution Project"
  description="A new and modern constitution that builds upon the principles of decentralization, separation of powers and limited government."
>
  <div
    class="bg-meander_dark [background-size:25px,25px] bg-repeat-x lg:flex lg:flex-row-reverse items-center pb-5 lg:min-h-[80vh]"
  >
    <div class="w-full p-[25px]">
      <Image
        src={ladyJustice}
        class="noselect object-contain lg:w-2/3 mx-auto"
        alt="Lady justice"
        loading="eager"
        width={528}
        height={528}
      />
    </div>
    <div>
      <h1
        class="text-[3.5rem] lg:leading-normal pl-2 text-black font-[Poppins] lg:text-[7vw]"
      >
        The New Constitution
      </h1>
      <div class="ml-2 mt-2">
        <Morpher client:load />
      </div>
      <div
        class="pl-2 pr-5 mt-4 w-full flex flex-col items-start gap-4 sm:flex-row sm:items-start"
      >
        <p
          class="text-sm sm:text-base lg:text-lg text-black/90 font-[Poppins] flex-1"
        >
          A constitution engineered to keep government limited through
          institutional incentive design
        </p>
        <a
          href="/draft"
          class="btn inline-flex self-center sm:self-auto sm:ml-auto bg-accent text-black hover:bg-success border border-black hover:border-black"
          >READ THE DRAFT!</a
        >
      </div>
    </div>
  </div>
  <Benefits />
  <div class="bg-meander_dark [background-size:25px,25px] bg-repeat-x h-[25px]">
  </div>
  <CardGallery />
  <Share />
</MainLayout>
