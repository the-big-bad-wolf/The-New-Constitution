---
import { getEntry, render } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { getLastRevised } from "../utils/lastRevised";
import { buildTocItems } from "../utils/toc";

const rationaleDocument = await getEntry("documents", "rationale");

if (!rationaleDocument) {
  throw new Error(
    "Missing rationale document at src/content/documents/rationale.md",
  );
}

const { Content, headings } = await render(rationaleDocument);
const tocItems = buildTocItems(headings);
const lastRevised = getLastRevised("src/content/documents/rationale.md");
---

<MainLayout
  title={`${rationaleDocument.data.title} | New Constitution Project`}
  description={rationaleDocument.data.description ??
    "A guide to the theoretical and empirical basis for the draft."}
>
  <div class="bg-meander_dark [background-size:25px,25px] bg-repeat-x">
    <div class="mx-auto max-w-5xl px-2 sm:px-8 pt-16 text-center">
      <h1 class="text-5xl font-semibold">
        {rationaleDocument.data.title}
      </h1>
      <div class="mt-3 flex flex-col items-center gap-1 text-sm">
        <p class="text-yellow-500">Early draft</p>
        {
          lastRevised && (
            <p class="text-base-content/70">
              Last revised{" "}
              <time datetime={lastRevised.iso}>{lastRevised.label}</time>
            </p>
          )
        }
      </div>
    </div>
  </div>

  <div class="flex justify-center">
    <div class="hidden xl:block xl:mr-8 mb-16">
      <TableOfContents items={tocItems} />
    </div>

    <article
      class="document-content min-w-0 flex-1 mx-1 px-2 sm:px-8 my-5 lg:my-16 max-w-5xl"
    >
      <Content />
    </article>

    <div class="hidden xl:block mb-16">
      <ReadingProgress markers={tocItems.map(item => item.href)} />
    </div>
  </div>
</MainLayout>
